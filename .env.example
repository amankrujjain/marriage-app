# Runtime
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000
SERVER_PUBLIC_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# GA4 (optional). Loaded only after the user Accepts cookies.
# Leave empty to disable analytics entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/marriage-biodata

# Auth (cookie access + refresh)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Hostinger mailbox (forgot-password emails)
# Create the mailbox in hPanel → Emails, then paste its password below.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@marriagebio.in
SMTP_PASS=
MAIL_FROM=MarriageBio <support@marriagebio.in>

# Redis (rate limits; optional in local — memory store used if empty)
REDIS_URL=redis://127.0.0.1:6379

# Razorpay Wedding Pass (₹151 / 30 days)
# KEY_ID is returned to the client from POST /billing/checkout (public); SECRET stays server-only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Prefer a dedicated webhook secret; falls back to KEY_SECRET if empty
RAZORPAY_WEBHOOK_SECRET=

# AI translation for download only (field values; labels stay English)
# Set AI_API_KEY to enable OpenAI. Without it, a small offline dictionary is used.
AI_PROVIDER=openai
AI_API_KEY=
# Optional model override (default: gpt-4o-mini)
AI_MODEL=gpt-4o-mini

# Cloudflare R2 (S3 API). Public bucket: blog images. Private bucket: profile photos and exports (presigned links).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=marriagebio-public
R2_PRIVATE_BUCKET=marriagebio-private
# Custom domain or r2.dev URL of the public bucket, no trailing slash
R2_PUBLIC_BASE_URL=https://media.marriagebio.in
# Key prefix; marriagebio-dev for local work
R2_ROOT_PREFIX=marriagebio
# Set TRUST_PROXY=1 behind nginx/load balancer so rate limits use real client IPs
TRUST_PROXY=

# Logging (Winston daily + weekly files under server/logs)
LOG_DIR=logs
LOG_RETENTION_DAYS=3

# Cron: secret for /api/v1/cron/* and scheduler outbound calls (x-cron-secret)
CRON_SECRET=change-me-to-a-long-cron-secret
