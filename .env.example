# Runtime
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000
SERVER_PUBLIC_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/marriage-biodata

# Auth (Phase 2)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Razorpay (Phase 7)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI translation (Phase 5)
AI_PROVIDER=openai
AI_API_KEY=

# Object storage / uploads (Phase 3+)
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
