# Runtime
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000
SERVER_PUBLIC_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/marriage-biodata

# Auth (cookie access + refresh)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Razorpay (Phase 7)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI translation for download only (field values; labels stay English)
# Set AI_API_KEY to enable OpenAI. Without it, a small offline dictionary is used.
AI_PROVIDER=openai
AI_API_KEY=
# Optional model override (default: gpt-4o-mini)
AI_MODEL=gpt-4o-mini

# Object storage / uploads (local now; swap to S3 later — media route stays the same)
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Set TRUST_PROXY=1 behind nginx/load balancer so rate limits use real client IPs
TRUST_PROXY=

# Logging (Winston daily + weekly files under server/logs)
LOG_DIR=logs
LOG_RETENTION_DAYS=3

# Cron: secret for /api/v1/cron/* and scheduler outbound calls (x-cron-secret)
CRON_SECRET=change-me-to-a-long-cron-secret
